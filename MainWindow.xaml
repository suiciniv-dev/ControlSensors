<Window x:Class="ControlSensors.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlSensors HUD" Height="480" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Consolas" Foreground="#f1f5f9">

    <Window.Resources>
        <Style x:Key="FlatProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#221a2233" CornerRadius="4" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1a2233"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#38bdf8"/>
            <Setter Property="Foreground" Value="#080a0f"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{Binding DragWindowCommand}" />
        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding MaximizeWindowCommand}" />
    </Window.InputBindings>

    <Grid Background="#0a0c11">

        <TextBlock Text="⚙" FontSize="20" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Cursor="Hand" MouseLeftButtonDown="BtnOpenConfig_Click" Panel.ZIndex="10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#38bdf8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- PAINEL 1: DASHBOARD DE SENSORES -->
        <Grid x:Name="PanelSensors" Margin="40,30,40,30" Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Viewbox MaxHeight="60" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtTime" Text="00:00" FontWeight="Bold" Foreground="White"/>
                </Viewbox>
                <TextBlock x:Name="TxtDate" Text="--- • 00 ---" FontSize="16" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CPU" FontSize="16" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtCpuTemp" Text="--°" FontSize="36" FontWeight="Bold" Foreground="#f97316"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtCpuUsage" Text="0%" FontSize="14" Margin="0,0,10,0" Width="40" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="BarCpu" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="8" Foreground="#38bdf8" BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="GPU" FontSize="16" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtGpuTemp" Text="--°" FontSize="36" FontWeight="Bold" Foreground="#f97316"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtGpuUsage" Text="0%" FontSize="14" Margin="0,0,10,0" Width="40" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="BarGpu" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="8" Foreground="#38bdf8" BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,20,0,20">
                <TextBlock Text="MEMÓRIA RAM" FontSize="14" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtRamDetail" Text="-- / -- GB" FontSize="16" Foreground="#cbd5e1" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="BarRam" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="8" Foreground="#38bdf8" BorderThickness="0" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRamPct" Grid.Column="1" Text="0%" FontSize="14" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <Rectangle Grid.Row="3" Height="1" Fill="#202738" Margin="0,0,0,15"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWeatherIcon" Text="🌧" FontSize="26" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtWeatherTemp" Text="--°C " FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtWeatherCity" Text=" Canoas, RS" FontSize="16" Foreground="#94a3b8" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWeatherCond" Text="---" FontSize="14" Foreground="#64748b" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtWeatherRange" Text="Máx --° • Mín --°" FontSize="14" Foreground="#64748b" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- PAINEL 2: MÚSICA EM TELA CHEIA -->
        <Grid x:Name="PanelMusic" Opacity="0" Visibility="Hidden">
            <Border Opacity="0.4">
                <Border.Background>
                    <ImageBrush x:Name="ImgMusicBg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
            </Border>

            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#dd080a0f" Offset="0.0"/>
                        <GradientStop Color="#ff080a0f" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.6*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="230" Height="230" CornerRadius="16" BorderBrush="#38bdf8" BorderThickness="1" Background="#1a2233" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.9" ShadowDepth="10"/>
                    </Border.Effect>
                    <Border CornerRadius="15" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="ImgMusicCoverCenter" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtMusicBigTitle" Text="Música" FontSize="42" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="110"/>
                    <TextBlock x:Name="TxtMusicBigArtist" Text="Artista" FontSize="22" Foreground="#94a3b8" Margin="0,5,0,15"/>

                    <StackPanel x:Name="AudioVisualizerPanel" Orientation="Horizontal" Margin="0,0,0,20" Height="45" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <Border x:Name="Bar0" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar1" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar2" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar3" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar4" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar5" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar6" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar7" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar8" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar9" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar10" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar11" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar12" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar13" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar14" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar15" Width="6" Height="4" Background="#38bdf8" Margin="0,0,0,0" CornerRadius="3" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <Border Background="#88000000" CornerRadius="8" Padding="15,12" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtMusicCarousel" Text="⏳ Carregando..." Foreground="#38bdf8" FontSize="18" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- PAINEL 3: CONFIGURAÇÕES -->
        <Border x:Name="PanelConfig" Visibility="Hidden" Opacity="0" Background="#ea080a0f" Panel.ZIndex="20">
            <Border Width="380" Background="#11151e" BorderBrush="#202738" BorderThickness="2" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="⚙ CONFIGURAÇÕES" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Localização (Clima):" Foreground="#94a3b8" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="InputCity" Style="{StaticResource FlatTextBox}" FontSize="16" Text="Canoas" Margin="0,0,0,20"/>

                    <CheckBox x:Name="ChkAutoStart" Content="Iniciar com o Windows (Auto-Start)" Foreground="White" FontSize="14" Margin="0,0,0,25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource FlatButton}" Background="#1a2233" Foreground="White" BorderBrush="#202738" BorderThickness="1" Content="Cancelar" Click="BtnCancelConfig_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Salvar" Click="BtnSaveConfig_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtConfigStatus" Foreground="#ef4444" FontSize="14" HorizontalAlignment="Center" Margin="0,15,0,15"/>

                    <!-- NOVO BOTÃO PARA FECHAR O APP -->
                    <Button Style="{StaticResource FlatButton}" Background="#ef4444" Foreground="White" Content="Encerrar HUD" Click="BtnCloseApp_Click"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>