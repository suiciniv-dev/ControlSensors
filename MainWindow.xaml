<Window x:Class="ControlSensors.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlSensors HUD" Height="480" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Consolas" Foreground="#f1f5f9">

    <Window.Resources>
        <Style x:Key="FlatProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#221a2233" CornerRadius="4" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1a2233"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#38bdf8"/>
            <Setter Property="Foreground" Value="#080a0f"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{Binding DragWindowCommand}" />
        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding MaximizeWindowCommand}" />
    </Window.InputBindings>

    <Grid Background="#0a0c11">

        <TextBlock Text="⚙" FontSize="20" Foreground="#64748b" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Cursor="Hand" MouseLeftButtonDown="BtnOpenConfig_Click" Panel.ZIndex="10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#38bdf8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="✖" FontSize="20" Foreground="#64748b" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Cursor="Hand" MouseLeftButtonDown="BtnCloseApp_Click" Panel.ZIndex="10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#ef4444"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        
        <!-- PAINEL 1: DASHBOARD DE SENSORES -->
        <Grid x:Name="PanelSensors" Margin="35,25,35,25" Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HORA E DATA -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <Viewbox MaxHeight="55" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtTime" Text="00:00" FontWeight="Bold" Foreground="White"/>
                </Viewbox>
                <TextBlock x:Name="TxtDate" Text="--- • 00 ---" FontSize="14" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- CPU E GPU -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card CPU -->
                <Border Grid.Column="0" Background="#131924" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="10" Padding="15,12">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtCpuTemp" Text="--°" FontSize="30" FontWeight="Bold" Foreground="#f97316"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCpuUsage" Text="0%" FontSize="13" Margin="0,0,8,0" Width="35" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="BarCpu" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="6" Foreground="#38bdf8" BorderThickness="0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card GPU -->
                <Border Grid.Column="2" Background="#131924" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="10" Padding="15,12">
                    <StackPanel>
                        <TextBlock Text="GPU" FontSize="13" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtGpuTemp" Text="--°" FontSize="30" FontWeight="Bold" Foreground="#f97316"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtGpuUsage" Text="0%" FontSize="13" Margin="0,0,8,0" Width="35" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="BarGpu" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="6" Foreground="#38bdf8" BorderThickness="0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MEMÓRIA RAM -->
            <Border Grid.Row="2" Background="#131924" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="10" Padding="15,10" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="MEMÓRIA RAM" FontSize="12" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRamDetail" Text="-- / -- GB" FontSize="13" Foreground="#cbd5e1" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BarRam" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="6" Foreground="#38bdf8" BorderThickness="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRamPct" Grid.Column="1" Text="0%" FontSize="13" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- NOVO: TRÁFEGO DE REDE -->
            <Grid Grid.Row="3" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#131924" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⬇" Foreground="#38bdf8" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="DOWNLOAD" FontSize="10" Foreground="#64748b" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtNetDownload" Text="0 KB/s" FontSize="13" FontWeight="Bold" Foreground="#f1f5f9"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#131924" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⬆" Foreground="#10b981" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="UPLOAD" FontSize="10" Foreground="#64748b" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtNetUpload" Text="0 KB/s" FontSize="13" FontWeight="Bold" Foreground="#f1f5f9"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Rectangle Grid.Row="4" Height="1" Fill="#1e293b" Margin="0,5,0,10"/>

            <!-- CLIMA -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWeatherIcon" Text="🌧" FontSize="24" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtWeatherTemp" Text="--°C " FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtWeatherCity" Text=" Canoas, RS" FontSize="14" Foreground="#94a3b8" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWeatherCond" Text="---" FontSize="13" Foreground="#64748b" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtWeatherRange" Text="Máx --° • Mín --°" FontSize="12" Foreground="#64748b" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- PAINEL 2: MÚSICA EM TELA CHEIA -->
        <Grid x:Name="PanelMusic" Opacity="0" Visibility="Hidden">
            <Border Opacity="0.4">
                <Border.Background>
                    <ImageBrush x:Name="ImgMusicBg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
            </Border>

            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#dd080a0f" Offset="0.0"/>
                        <GradientStop Color="#ff080a0f" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.6*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="230" Height="230" CornerRadius="16" BorderBrush="#38bdf8" BorderThickness="1" Background="#1a2233" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.9" ShadowDepth="10"/>
                    </Border.Effect>
                    <Border CornerRadius="15" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="ImgMusicCoverCenter" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtMusicBigTitle" Text="Música" FontSize="42" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="110"/>
                    <TextBlock x:Name="TxtMusicBigArtist" Text="Artista" FontSize="22" Foreground="#94a3b8" Margin="0,5,0,15"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="⏮" FontSize="26" Foreground="#94a3b8" Margin="0,0,20,0" Cursor="Hand" MouseLeftButtonDown="BtnPrev_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#38bdf8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="⏯" FontSize="26" Foreground="#94a3b8" Margin="0,0,20,0" Cursor="Hand" MouseLeftButtonDown="BtnPlayPause_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#38bdf8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="⏭" FontSize="26" Foreground="#94a3b8" Cursor="Hand" MouseLeftButtonDown="BtnNext_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#38bdf8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                    <StackPanel x:Name="AudioVisualizerPanel" Orientation="Horizontal" Margin="0,0,0,20" Height="45" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <Border x:Name="Bar0" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar1" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar2" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar3" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar4" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar5" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar6" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar7" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar8" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar9" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar10" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar11" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar12" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar13" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar14" Width="6" Height="4" Background="#38bdf8" Margin="0,0,4,0" CornerRadius="3" VerticalAlignment="Bottom" />
                        <Border x:Name="Bar15" Width="6" Height="4" Background="#38bdf8" Margin="0,0,0,0" CornerRadius="3" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <Border Background="#88000000" CornerRadius="8" Padding="15,12" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtMusicCarousel" Text="⏳ Carregando..." Foreground="#38bdf8" FontSize="18" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- PAINEL 3: MODO JOGO (DASHBOARD DE PERFORMANCE) -->
        <!-- PAINEL 3: MODO JOGO (DASHBOARD DE PERFORMANCE AGRESSIVO) -->
        <Grid x:Name="PanelGame" Opacity="0" Visibility="Hidden" Background="#050505">
            <!-- Fundo de grade com gradiente de alerta térmico -->
            <Border>
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#2a0808" Offset="0.0"/>
                        <GradientStop Color="#080505" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="30,20,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho Agressivo -->
                <Border Grid.Row="0" Background="#ef4444" CornerRadius="4" HorizontalAlignment="Center" Padding="20,4">
                    <Border.Effect>
                        <DropShadowEffect Color="#ef4444" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ MODO DE ALTO DESEMPENHO ATIVO: " FontSize="12" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtGameTitle" Text="[JOGO]" FontSize="14" FontWeight="Bold" Foreground="#ffe4e6" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- CPU e GPU em Destaque Absoluto -->
                <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card CPU Gigante -->
                    <Border Grid.Column="0" Background="#0f0f13" BorderBrush="#2a1010" BorderThickness="2" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="PROCESSADOR (CPU)" FontSize="14" FontWeight="Black" Foreground="#7f1d1d" Margin="0,0,0,0"/>
                            <TextBlock x:Name="TxtGameCpuTemp" Text="--°" FontSize="80" FontWeight="Black" Foreground="#ef4444" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtGameCpuUsage" Text="0%" FontSize="20" FontWeight="Bold" Margin="0,0,12,0" Width="60" Foreground="#f87171" VerticalAlignment="Center" TextAlignment="Right"/>
                                <ProgressBar x:Name="BarGameCpu" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="12" Foreground="#ef4444" BorderThickness="0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card GPU Gigante -->
                    <Border Grid.Column="2" Background="#0f0f13" BorderBrush="#2a1010" BorderThickness="2" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="14" FontWeight="Black" Foreground="#7f1d1d" Margin="0,0,0,0"/>
                            <TextBlock x:Name="TxtGameGpuTemp" Text="--°" FontSize="80" FontWeight="Black" Foreground="#ef4444" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtGameGpuUsage" Text="0%" FontSize="20" FontWeight="Bold" Margin="0,0,12,0" Width="60" Foreground="#f87171" VerticalAlignment="Center" TextAlignment="Right"/>
                                <ProgressBar x:Name="BarGameGpu" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="0" Maximum="100" Height="12" Foreground="#ef4444" BorderThickness="0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Rodapé -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0f0f13" BorderBrush="#2a1010" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="USO DE RAM: " FontSize="14" Foreground="#991b1b" FontWeight="Black"/>
                            <TextBlock x:Name="TxtGameRam" Text="--%" FontSize="16" Foreground="#fca5a5" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#0f0f13" BorderBrush="#2a1010" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="TRÁFEGO DE REDE: " FontSize="14" Foreground="#991b1b" FontWeight="Black"/>
                            <TextBlock x:Name="TxtGameNet" Text="0 KB/s" FontSize="16" Foreground="#fca5a5" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- PAINEL 3: CONFIGURAÇÕES -->
        <Border x:Name="PanelConfig" Visibility="Hidden" Opacity="0" Background="#ea080a0f" Panel.ZIndex="20">
            <Border Width="380" Background="#11151e" BorderBrush="#202738" BorderThickness="2" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="⚙ CONFIGURAÇÕES" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Localização (Clima):" Foreground="#94a3b8" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="InputCity" Style="{StaticResource FlatTextBox}" FontSize="16" Text="Canoas" Margin="0,0,0,20"/>

                    <CheckBox x:Name="ChkAutoStart" Content="Iniciar com o Windows (Auto-Start)" Foreground="White" FontSize="14" Margin="0,0,0,25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource FlatButton}" Background="#1a2233" Foreground="White" BorderBrush="#202738" BorderThickness="1" Content="Cancelar" Click="BtnCancelConfig_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Salvar" Click="BtnSaveConfig_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtConfigStatus" Foreground="#ef4444" FontSize="14" HorizontalAlignment="Center" Margin="0,15,0,15"/>

                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>